# Adzuna credentials — register at developer.adzuna.com
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=in

# Search configuration
JOB_LOCATION=Delhi NCR
JOB_TARGET_COUNT=10
JOB_FRESHNESS_HOURS=24

# Optional public ATS boards. Comma-separated company board tokens/sites.
# Example:
# GREENHOUSE_BOARDS=company1,company2
# LEVER_SITES=company1,company2
GREENHOUSE_BOARDS=
LEVER_SITES=

# Optional future AI matching
OPENAI_API_KEY=
DATABASE_URL=sqlite:///./jobs.db
