# Adzuna credentials — register at developer.adzuna.com
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=in

# Search configuration
JOB_LOCATION=Delhi NCR
JOB_REMOTE_LOCATION=Remote
JOB_TARGET_COUNT=20
JOB_FRESHNESS_HOURS=48

# Optional public ATS boards. Comma-separated company board tokens/sites.
# These must be real Greenhouse board tokens, Lever site names, or Ashby board names.
GREENHOUSE_BOARDS=
LEVER_SITES=
ASHBY_BOARDS=

# Optional future AI matching
OPENAI_API_KEY=
DATABASE_URL=sqlite:///./jobs.db
